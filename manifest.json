{
  "manifest_version": 3,
  "name": "Stackblock — Feed Blocker",
  "version": "1.1.0",
  "description": "Hide the Substack home feed and recommendation widgets, and the Twitter/X home timeline (except during lunch, 12–1pm local).",
  "permissions": ["storage"],
  "host_permissions": [
    "*://substack.com/*",
    "*://twitter.com/*",
    "*://x.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://substack.com/*",
        "*://twitter.com/*",
        "*://x.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stackblock"
  }
}
